{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "type" : "object",
  "properties" : {
    "chamado" : {
      "type" : "object",
      "properties" : {
        "id" : {
          "type" : "string",
          "format" : "uuid"
        },
        "numero" : {
          "type" : "integer",
          "format" : "int64"
        }
      },
      "required" : [ "id", "numero" ],
      "additionalProperties" : false
    },
    "destinatarios" : {
      "type" : "array",
      "minItems" : 1,
      "items" : {
        "type" : "string",
        "format" : "email"
      },
      "maxItems" : 1,
      "description" : "E-mail de contato do cliente (RN-08, RN-41)"
    },
    "titulo" : {
      "type" : "string",
      "minLength" : 1
    },
    "eventoId" : {
      "type" : "string",
      "format" : "uuid",
      "description" : "Identificador do evento; os consumidores descartam repetições por ele (RN-55)"
    },
    "tipo" : {
      "const" : "RESOLUCAO"
    }
  },
  "required" : [ "chamado", "destinatarios", "titulo", "eventoId", "tipo" ],
  "additionalProperties" : false,
  "title" : "RESOLUCAO"
}
