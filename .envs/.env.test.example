# Environment
ENVIRONMENT=test

# Fuso único do sistema (RN-62): app e Postgres
FUSO_HORARIO=America/Fortaleza

# Docker Configuration
LOCAL_PORT=8080
DOCKER_PORT=8080

# Postgres superuser (só inicialização do container)
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=test_admin_password

# Database Postgres Configuration (app-principal)
DATABASE_TYPE=postgresql
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_DB=app_principal
DATABASE_USER=app_principal
DATABASE_PASSWORD=test_app_password

# Banco do ms-notificacoes (no mesmo Postgres; o app-principal não acessa)
NOTIFICACOES_DB_USER=notificacoes
NOTIFICACOES_DB_PASSWORD=test_notificacoes_password

# Banco do Keycloak (no mesmo Postgres)
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=test_keycloak_password

# JPA Configuration
JPA_SHOW_SQL=false

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=app_principal
RABBITMQ_PASSWORD=test_rabbitmq_password

# MinIO
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=test_minio_password

# Keycloak (admin do console)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=test_keycloak_admin_password

# SPRING SECURITY
SPRING_SECURITY_USER_NAME=test
SPRING_SECURITY_USER_PASSWORD=test123456
