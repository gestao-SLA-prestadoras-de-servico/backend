# Environment
ENVIRONMENT=test

# Docker Configuration
LOCAL_PORT=8080
DOCKER_PORT=8080

# Database Postgres Configuration
DATABASE_TYPE=postgresql
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_DB=test_db
DATABASE_USER=test_user
DATABASE_PASSWORD=test_password

# JPA Configuration
JPA_DDL_AUTO=create-drop
JPA_SHOW_SQL=false