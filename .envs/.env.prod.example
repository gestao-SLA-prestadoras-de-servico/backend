# Environment
ENVIRONMENT=prod

# Docker Configuration
LOCAL_PORT=8080
DOCKER_PORT=8080

# Database Postgres Configuration
DATABASE_TYPE=postgresql
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_DB=prod_db
DATABASE_USER=prod_user
DATABASE_PASSWORD=prod_password

# JPA Configuration
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false