# Environment
ENVIRONMENT=prod

# Fuso único do sistema (RN-62): app e Postgres
FUSO_HORARIO=America/Fortaleza

# Docker Configuration
LOCAL_PORT=8080
DOCKER_PORT=8080

# Postgres superuser (só inicialização do container)
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=troque-esta-senha

# Database Postgres Configuration (app-principal)
DATABASE_TYPE=postgresql
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_DB=app_principal
DATABASE_USER=app_principal
DATABASE_PASSWORD=troque-esta-senha

# Banco do ms-notificacoes (no mesmo Postgres; o app-principal não acessa)
NOTIFICACOES_DB_USER=notificacoes
NOTIFICACOES_DB_PASSWORD=troque-esta-senha

# Banco do Keycloak (no mesmo Postgres)
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=troque-esta-senha

# JPA Configuration
JPA_SHOW_SQL=false

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=app_principal
RABBITMQ_PASSWORD=troque-esta-senha

# MinIO
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=troque-esta-senha

# Keycloak (admin do console)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=troque-esta-senha

# Keycloak: realm flowsla (infra/keycloak/realm-flowsla.json)
# iss do token: em dev o navegador usa localhost:8081; sem porta publicada, o host interno.
KEYCLOAK_ISSUER_URI=https://troque-este-host/realms/flowsla
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/flowsla/protocol/openid-connect/certs
# Senha do usuário "gestor" (gestor inicial, criado no import do realm)
KEYCLOAK_GESTOR_PASSWORD=troque-esta-senha
# Segredo do client app-principal-admin (conta de serviço da Admin API, RN-137)
KEYCLOAK_ADMIN_CLIENT_SECRET=troque-este-segredo

# Frontend (redirect do client flowsla-frontend)
FRONTEND_URL=http://localhost:5173

# SMTP (Mailpit em dev/test), usado pelo Keycloak (RN-138)
SMTP_HOST=mailpit
SMTP_PORT=1025
